generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  name              String
  email             String         @unique
  role              Role           @default(lecturer)
  password          String
  remember_token    String?        @db.VarChar(100)
  created_at        DateTime       @default(now()) @db.Timestamp(0)
  updated_at        DateTime       @updatedAt @db.Timestamp(0)
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lecturer          Lecturer?
  student           Student?

  @@map("users")
}

model Faculty {
  faculty_code String     @id @db.VarChar(20)
  name         String     @unique @db.VarChar(100)
  created_at   DateTime   @default(now()) @db.Timestamp(0)
  updated_at   DateTime   @updatedAt @db.Timestamp(0)
  classes      Class[]
  lecturers    Lecturer[]

  @@map("faculties")
}

model Class {
  class_code   String    @id @db.VarChar(20)
  name   String    @db.VarChar(100)
  faculty_code String    @db.VarChar(20)
  created_at   DateTime  @default(now()) @db.Timestamp(0)
  updated_at   DateTime  @updatedAt @db.Timestamp(0)
  faculty      Faculty   @relation(fields: [faculty_code], references: [faculty_code], onDelete: Restrict)
  students     Student[]

  @@index([faculty_code])
  @@map("classes")
}

model Subject {
  subject_code   String         @id @db.VarChar(20)
  name           String         @db.VarChar(100)
  created_at     DateTime       @default(now()) @db.Timestamp(0)
  updated_at     DateTime       @updatedAt @db.Timestamp(0)
  exam_schedules ExamSchedule[]

  @@map("subjects")
}

model Student {
  student_code       String             @id @db.VarChar(20)
  class_code         String             @db.VarChar(20)
  last_name          String             @db.VarChar(70)
  first_name         String             @db.VarChar(30)
  email              String            @unique @db.VarChar(100)
  phone              String?            @unique @db.VarChar(15)
  created_at         DateTime           @default(now()) @db.Timestamp(0)
  updated_at         DateTime           @updatedAt @db.Timestamp(0)
  user_id            String?            @unique @db.Uuid
  attendance_records AttendanceRecord[]
  photos             StudentPhoto[]
  class              Class             @relation(fields: [class_code], references: [class_code], onDelete: Restrict)
  user               User?              @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([class_code])
  @@map("students")
}

model Lecturer {
  lecturer_code     String           @id @db.VarChar(20)
  last_name         String          @db.VarChar(70)
  first_name        String          @db.VarChar(30)
  email             String          @unique @db.VarChar(100)
  phone             String?         @unique @db.VarChar(15)
  faculty_code      String          @db.VarChar(20)
  created_at        DateTime         @default(now()) @db.Timestamp(0)
  updated_at        DateTime         @updatedAt @db.Timestamp(0)
  user_id           String?          @unique @db.Uuid
  supervising_exams ExamSupervisor[]
  faculty           Faculty         @relation(fields: [faculty_code], references: [faculty_code], onDelete: Restrict)
  user              User?           @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([faculty_code])
  @@map("lecturers")
}

model ExamPeriod {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String         @db.VarChar(200)
  start_date     DateTime       @db.Date
  end_date       DateTime       @db.Date
  created_at     DateTime       @default(now()) @db.Timestamp(0)
  updated_at     DateTime       @updatedAt @db.Timestamp(0)
  exam_schedules ExamSchedule[]

  @@map("exam_periods")
}

model ExamSchedule {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject_code       String             @db.VarChar(20)
  group              Int
  start_time         DateTime           @db.Timestamptz(3)
  duration           Int
  room_code          String             @db.VarChar(20)
  note               String?
  exam_period_id     String?            @db.Uuid
  created_at         DateTime           @default(now()) @db.Timestamp(0)
  updated_at         DateTime           @updatedAt @db.Timestamp(0)
  attendance_records AttendanceRecord[]
  subject            Subject            @relation(fields: [subject_code], references: [subject_code], onDelete: Restrict)
  room               Room               @relation(fields: [room_code], references: [room_code], onDelete: Restrict)
  exam_period        ExamPeriod?        @relation(fields: [exam_period_id], references: [id], onDelete: SetNull)
  exam_supervisors        ExamSupervisor[]

  @@unique([subject_code, start_time, room_code])
  @@index([room_code])
  @@index([start_time])
  @@index([exam_period_id])
  @@map("exam_schedules")
}

model ExamSupervisor {
  lecturer_code    String       @db.VarChar(20)
  created_at       DateTime     @default(now()) @db.Timestamp(0)
  updated_at       DateTime     @updatedAt @db.Timestamp(0)
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_schedule_id String       @db.Uuid
  exam_schedule    ExamSchedule @relation(fields: [exam_schedule_id], references: [id], onDelete: Cascade)
  lecturer         Lecturer     @relation(fields: [lecturer_code], references: [lecturer_code], onDelete: Cascade)

  @@index([exam_schedule_id])
  @@index([lecturer_code])
  @@map("exam_supervisors")
}

model AttendanceRecord {
  student_code       String             @db.VarChar(20)
  attendance_method  AttendanceMethod?
  rekognition_result RekognitionResult?
  confidence         Decimal?           @db.Decimal(5, 2)
  attendance_time    DateTime?          @db.Timestamp(0)
  note               String?            @db.Text
  created_at         DateTime           @default(now()) @db.Timestamp(0)
  updated_at         DateTime           @updatedAt @db.Timestamp(0)
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_schedule_id   String             @db.Uuid
  exam_schedule      ExamSchedule       @relation(fields: [exam_schedule_id], references: [id], onDelete: Cascade)
  student            Student            @relation(fields: [student_code], references: [student_code], onDelete: Cascade)

  @@unique([student_code, exam_schedule_id])
  @@index([exam_schedule_id])
  @@index([student_code])
  @@map("attendance_records")
}

model StudentPhoto {
  student_code        String    @db.VarChar(20)
  image_url           String    @db.VarChar(255)
  created_at          DateTime  @default(now()) @db.Timestamp(0)
  updated_at          DateTime  @updatedAt @db.Timestamp(0)
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student             Student   @relation(fields: [student_code], references: [student_code], onDelete: Cascade)

  @@index([student_code])
  @@map("student_photos")
}

enum Role {
  admin
  lecturer
  student
}

enum AttendanceMethod {
  face
  qr_code
}

enum RekognitionResult {
  match
  not_match
  unknown
}

model Room {
  room_code      String         @id @db.VarChar(20)
  name           String         @db.VarChar(100)
  capacity       Int
  created_at     DateTime       @default(now()) @db.Timestamp(0)
  updated_at     DateTime       @updatedAt @db.Timestamp(0)
  exam_schedules ExamSchedule[]

  @@map("rooms")
}
